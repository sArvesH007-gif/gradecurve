# Historical PostgreSQL / Prisma development commands only. The active app uses Oracle.
DATABASE_URL=""
DIRECT_URL=""

# Set a local demo account password before running the seed.
DEMO_PASSWORD=""

# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Oracle is the primary relational database for the active app.
ORACLE_USER=""
ORACLE_PASSWORD=""
ORACLE_CONNECT_STRING="localhost:1522/FREEPDB1"

# Neo4j graph database. The graph contains synthetic demo records only.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
