# Copy to .env.local and set local PostgreSQL connection URLs.
DATABASE_URL=""
DIRECT_URL=""

# Set a local demo account password before running the seed.
DEMO_PASSWORD=""

# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Local Neo4j graph database (see docker-compose.yml)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
